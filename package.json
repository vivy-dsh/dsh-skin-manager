{
  "name": "dsh-skin-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skin gallery for the vivy-dsh panel: the built-in vivy skin plus the four oh-dsh palettes (ported from hust-open-atom-club/oh-dsh).",
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "tools",
    "verify-skin-manager.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  }
}
